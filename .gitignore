# ============================================================
# LVIS Leviathan Trading System - .gitignore
# ============================================================

# ── Node.js / Frontend ──────────────────────────────────────
node_modules/
frontend/dist/
frontend/.vite/
frontend/.env
frontend/.env.local

# ── Python ──────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.egg-info/
venv/
env/
.venv/

# ── 後端伺服器（機密）────────────────────────────────────────
# server/ 整個目錄不上傳（含策略邏輯、API 金鑰、憑證）
server/
server/*


# ── 策略原始檔 ───────────────────────────────────────────────
# Pine Script 策略原始碼
v6.txt
# 自定義標的清單
list.txt
*.txt

# ── 環境變數 & 金鑰 ─────────────────────────────────────────
.env
.env.local
.env.*.local
*.env
*.pfx
*.pem
*.key
*.json.bak

# ── Firebase 本地設定 ────────────────────────────────────────
firebase.json
.firebaserc

# ── 日誌 ────────────────────────────────────────────────────
*.log
logbook.log
logs/

# ── 本機執行腳本（含機器絕對路徑，不適合上傳）────────────────
run_*.bat

# ── OS / IDE ────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
