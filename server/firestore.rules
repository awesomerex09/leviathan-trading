rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // 工具函式
    // ============================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    // Admin UID 白名單 - 請確認此 UID 與 firebase.js 中的 ADMIN_UID 一致
    function isAdmin() {
      return isSignedIn() && request.auth.uid == 'Za2Y2KDjDDVLI7qkHCyhqdfnrMu1';
    }

    // ============================================================
    // /users/{uid}
    // ============================================================
    match /users/{uid} {
      // 用戶讀自己；Admin 讀所有
      allow read: if isOwner(uid) || isAdmin();

      // Admin 可以直接更新用戶狀態（isPaid / isActive）
      // 一般用戶不能寫（憑證寫入由後端 API 負責，透過 Firebase Admin SDK）
      allow write: if isAdmin();

      match /orders/{orderId} {
        allow read: if isOwner(uid) || isAdmin();
        allow write: if false; // 只有後端 Admin SDK 能寫
      }
    }

    // ============================================================
    // /watchlist - Admin 可以讀寫（直接從前端操作）
    // ============================================================
    match /watchlist/{docId} {
      allow read: if isSignedIn();   // 後端伺服器讀取時也需要，這裡開放已登入用戶
      allow write: if isAdmin();
    }

    // ============================================================
    // /strategy - Admin 可以讀寫（直接從前端操作）
    // ============================================================
    match /strategy/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // ============================================================
    // 預設：拒絕所有其他存取
    // ============================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
