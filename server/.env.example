# 後端伺服器環境變數
# 將此檔案放在 server/ 目錄下，並命名為 .env

# AES 加密金鑰 (必須是 32 個字元)
AES_SECRET_KEY=your_32_char_secret_key_here!!

# Webhook 驗證密鑰 (TradingView 設定的 Webhook URL 需包含此密鑰)
WEBHOOK_SECRET=your_webhook_secret_here

# 管理員 Firebase UID（白名單，多個以逗號分隔）
ADMIN_UIDS=Za2Y2KDjDDVLI7qkHCyhqdfnrMu1

# Firebase 服務帳戶金鑰路徑
SERVICE_ACCOUNT_PATH=serviceAccountKey.json
